{
  "name": "pi-minimal",
  "version": "0.2.2",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raviy06/pi-minimal.git"
  },
  "homepage": "https://github.com/raviy06/pi-minimal#readme",
  "bugs": {
    "url": "https://github.com/raviy06/pi-minimal/issues"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "themes": [
      "./themes/minimal-dark.json"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "*",
    "eslint": "^10.11.0",
    "typescript": "*",
    "typescript-eslint": "^8.70.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.tests.json && node --test test-dist/test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
